# Environment Configuration Example (PROMPT Chiến v2.0)
# No secrets in git!

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://nextgame_user:nextgame_dev_password@localhost:5432/nextgame_db

# S3 / MinIO Object Storage for Replays
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nextgame-replays
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_dev_password

# Engine & Release Digests
ENGINE_DIGEST=sha256:alpha0_engine_digest_placeholder
RULESET_DIGEST=sha256:alpha0_ruleset_digest_placeholder
CATALOG_DIGEST=sha256:alpha0_catalog_digest_placeholder
