{
  "name": "prompt-chien", "version": "0.0.0", "private": true, "type": "module",
  "packageManager": "pnpm@10.34.6", "engines": {"node": "24.18.0", "pnpm": "10.34.6"},
  "scripts": {
    "build": "tsc -b && pnpm --filter @prompt-chien/web build",
    "check": "tsc -b && tsc -p tests/tsconfig.json && node scripts/boundaries.mjs",
    "test:unit": "tsc -b && vitest run",
    "dev": "node scripts/dev.mjs",
    "env:init": "node scripts/env.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "contracts:freeze": "node scripts/freeze.mjs",
    "compile:sandbox": "node scripts/compile-sandbox.mjs",
    "test:linux": "node scripts/linux-check.mjs",
    "test:browser": "node apps/web/node_modules/vite/bin/vite.js --config tests/browser/vite.config.ts",
    "test:e2e": "node scripts/smoke.mjs",
    "test:sim": "node scripts/deferred.mjs G1 simulation",
    "verify:replay": "node scripts/deferred.mjs T06 replay"
  },
  "devDependencies": {"typescript": "5.9.3", "@types/node": "24.10.1", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "vitest": "5.0.3"}
}
