                "forward": {
                  "kind": "const",
                  "value": 700
                },
                "strafe": {
                  "kind": "const",
                  "value": 0
                }
              },
              "turn": {
                "kind": "clamp",
                "value": {
                  "kind": "sensor",
                  "name": "enemy.bearing"
                },
                "min": {
                  "kind": "const",
                  "value": -1000
                },
                "max": {
                  "kind": "const",
                  "value": 1000
                }
              },
              "modules": [
                {
                  "moduleId": "bladeFront",
                  "action": "activate",
                  "aimOffset": {
                    "kind": "const",
                    "value": 0
                  },
                  "priority": 0
                }
              ]
            }
          },
          {
            "id": "approach",
            "when": {
              "kind": "bool",
              "value": true
            },
            "intent": {
              "thrust": {
                "forward": {
                  "kind": "const",
                  "value": 800
                },
                "strafe": {
                  "kind": "const",
                  "value": 0
                }
              },
              "turn": {
                "kind": "clamp",
                "value": {
                  "kind": "sensor",
                  "name": "enemy.bearing"
                },
                "min": {
                  "kind": "const",
                  "value": -1000
                },
                "max": {
                  "kind": "const",
                  "value": 1000
                }
              },
              "modules": []
            }
          }
        ]
      },
      {
        "id": "recover",
        "rules": [
          {
            "id": "returnToFight",
            "when": {
              "kind": "compare",
              "op": "gte",
              "left": {
                "kind": "sensor",
                "name": "clock.stateAge"
              },
              "right": {
                "kind": "const",
                "value": 3
              }
            },
