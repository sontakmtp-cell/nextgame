      {
        "id": "engage",
        "rules": [
          {
            "id": "evadeWindup",
            "when": {
              "kind": "compare",
              "op": "eq",
              "left": {
                "kind": "sensor",
                "name": "enemy.telegraph"
              },
              "right": {
                "kind": "const",
                "value": 1
              }
            },
            "intent": {
              "thrust": {
                "forward": {
                  "kind": "const",
                  "value": 0
                },
                "strafe": {
                  "kind": "const",
                  "value": 1000
                }
              },
              "turn": {
                "kind": "clamp",
                "value": {
                  "kind": "sensor",
                  "name": "enemy.bearing"
                },
                "min": {
                  "kind": "const",
                  "value": -1000
                },
                "max": {
                  "kind": "const",
                  "value": 1000
                }
              },
              "modules": []
            },
            "nextState": "recover"
          },
          {
            "id": "strike",
            "when": {
              "kind": "compare",
              "op": "lte",
              "left": {
                "kind": "sensor",
                "name": "enemy.distance"
              },
              "right": {
                "kind": "const",
                "value": 3500
              }
            },
            "intent": {
